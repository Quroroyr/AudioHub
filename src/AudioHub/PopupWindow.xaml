<Window x:Class="AudioHub.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:AudioHub.ViewModels"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance vm:MainViewModel}"
        Title="AudioHub"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize"
        Width="400" SizeToContent="Height"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        Foreground="{DynamicResource Fg}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Window.Resources>
        <!-- Основное устройство: имя, mute, ползунок, уровень сигнала -->
        <DataTemplate x:Key="DeviceCard" DataType="{x:Type vm:DeviceViewModel}">
            <Grid Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="9,0,0,0">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                    <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" Margin="8,1,0,0" MaxWidth="150" />
                </StackPanel>

                <Button Grid.Row="1" Style="{StaticResource FlatButton}" Command="{Binding ToggleMuteCommand}"
                        Width="36" Height="32" ToolTip="Выключить / включить звук">
                    <TextBlock Style="{StaticResource IconText}">
                        <TextBlock.Text>
                            <MultiBinding Converter="{StaticResource VolumeGlyph}">
                                <Binding Path="Volume" />
                                <Binding Path="IsMuted" />
                                <Binding Path="IsInput" />
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </Button>

                <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource VolumeSlider}"
                        Value="{Binding Volume}" Tag="{Binding IsMuted}" />

                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:0}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Rectangle Grid.Row="2" Grid.Column="1" Height="2" Margin="10,0" RadiusX="1" RadiusY="1"
                           Fill="{DynamicResource Accent}" Opacity="0.55" RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Peak}" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
        </DataTemplate>

        <!-- Строка в раскрытом списке устройств: клик — сделать основным -->
        <DataTemplate x:Key="DeviceRow" DataType="{x:Type vm:DeviceViewModel}">
            <Button Style="{StaticResource FlatButton}" Command="{Binding MakeDefaultCommand}"
                    HorizontalContentAlignment="Stretch" Padding="6,6" Margin="0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="28" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource IconText}" FontSize="12" Text="&#xE73E;" Foreground="{DynamicResource Accent}"
                               Visibility="{Binding IsDefault, Converter={StaticResource Visibility}}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Description}" Style="{StaticResource Secondary}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <!-- Программа в микшере -->
        <DataTemplate x:Key="AppRow" DataType="{x:Type vm:AppViewModel}">
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="40" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="4" />
                </Grid.RowDefinitions>

                <DockPanel Grid.Column="1" Grid.ColumnSpan="2" Margin="9,0,0,0" LastChildFill="True">
                    <Button DockPanel.Dock="Right" Style="{StaticResource FlatButton}" Padding="6,2"
                            Click="OnAppDeviceClick" ToolTip="Куда выводить звук этой программы"
                            Visibility="{Binding CanRoute, Converter={StaticResource Visibility}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="DeviceLabel" Text="{Binding DeviceLabel}" Style="{StaticResource Secondary}" MaxWidth="150" />
                            <TextBlock Style="{StaticResource IconText}" FontSize="9" Text="&#xE70D;" Margin="6,1,0,0"
                                       Foreground="{DynamicResource FgSecondary}" />
                        </StackPanel>
                    </Button>
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </DockPanel>

                <Button Grid.Row="1" Style="{StaticResource FlatButton}" Command="{Binding ToggleMuteCommand}"
                        Width="36" Height="32" ToolTip="Выключить / включить звук программы">
                    <Grid>
                        <Image x:Name="AppIcon" Source="{Binding Icon}" Width="20" Height="20"
                               RenderOptions.BitmapScalingMode="HighQuality"
                               Visibility="{Binding Icon, Converter={StaticResource Visibility}}" />
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE767;"
                                   Visibility="{Binding Icon, Converter={StaticResource Visibility}, ConverterParameter=Invert}" />
                        <Border x:Name="MuteBadge" Visibility="Collapsed" Background="{DynamicResource Bg}" CornerRadius="7"
                                Width="14" Height="14" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-5">
                            <TextBlock Style="{StaticResource IconText}" FontSize="10" Text="&#xE74F;" />
                        </Border>
                    </Grid>
                </Button>

                <Slider Grid.Row="1" Grid.Column="1" Style="{StaticResource VolumeSlider}"
                        Value="{Binding Volume}" Tag="{Binding IsMuted}" />

                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding Volume, StringFormat={}{0:0}}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />

                <Rectangle Grid.Row="2" Grid.Column="1" Height="2" Margin="10,0" RadiusX="1" RadiusY="1"
                           Fill="{DynamicResource Accent}" Opacity="0.55" RenderTransformOrigin="0,0.5">
                    <Rectangle.RenderTransform>
                        <ScaleTransform ScaleX="{Binding Peak}" />
                    </Rectangle.RenderTransform>
                </Rectangle>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMuted}" Value="True">
                    <Setter TargetName="AppIcon" Property="Opacity" Value="0.4" />
                    <Setter TargetName="MuteBadge" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRouted}" Value="True">
                    <Setter TargetName="DeviceLabel" Property="Foreground" Value="{DynamicResource Accent}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Кнопка-стрелка «показать все устройства» -->
        <Style x:Key="ExpandButton" TargetType="Button" BasedOn="{StaticResource FlatButton}">
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="ToolTip" Value="Выбрать устройство" />
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <!-- Тень отдельным слоем, чтобы эффект не размывал текст -->
        <Border CornerRadius="8" Background="{DynamicResource Bg}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="14" ShadowDepth="2" Opacity="0.35" />
            </Border.Effect>
        </Border>

        <Border CornerRadius="8" Background="{DynamicResource Bg}" BorderBrush="{DynamicResource Line}" BorderThickness="1">
            <DockPanel>
                <!-- Низ панели прибит к низу, остальное прокручивается, если не влезает в экран -->
                <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0"
                        Background="{DynamicResource Card}" CornerRadius="0,0,8,8" Padding="8,4">
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource FlatButton}" Padding="8,6" Click="OnSoundSettingsClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE713;" />
                                <TextBlock Text="Параметры звука" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource FlatButton}" Padding="8,6" Click="OnClassicPanelClick" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource IconText}" FontSize="14" Text="&#xE8B7;" />
                                <TextBlock Text="Панель звука" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="12,12,12,8">
                    <!-- Вывод -->
                    <DockPanel Margin="4,0,0,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ExpandButton}" Command="{Binding ToggleAllOutputsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Outputs.Count, StringFormat=Устройств: {0}}" Style="{StaticResource Secondary}" />
                                <TextBlock x:Name="OutputsChevron" Style="{StaticResource IconText}" FontSize="9" Text="&#xE70D;" Margin="6,1,0,0"
                                           Foreground="{DynamicResource FgSecondary}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="ВЫВОД" Style="{StaticResource SectionHeader}" />
                    </DockPanel>
                    <ContentControl Content="{Binding DefaultOutput}" ContentTemplate="{StaticResource DeviceCard}" Focusable="False"
                                    Visibility="{Binding DefaultOutput, Converter={StaticResource Visibility}}" />
                    <TextBlock Text="Нет подключённых устройств вывода" Style="{StaticResource Secondary}" Margin="4,6"
                               Visibility="{Binding DefaultOutput, Converter={StaticResource Visibility}, ConverterParameter=Invert}" />
                    <Border Background="{DynamicResource Card}" CornerRadius="6" Padding="4" Margin="0,6,0,0"
                            Visibility="{Binding ShowAllOutputs, Converter={StaticResource Visibility}}">
                        <ItemsControl ItemsSource="{Binding Outputs}" ItemTemplate="{StaticResource DeviceRow}" Focusable="False" />
                    </Border>

                    <!-- Ввод -->
                    <DockPanel Margin="4,14,0,2">
                        <Button DockPanel.Dock="Right" Style="{StaticResource ExpandButton}" Command="{Binding ToggleAllInputsCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Inputs.Count, StringFormat=Устройств: {0}}" Style="{StaticResource Secondary}" />
                                <TextBlock Style="{StaticResource IconText}" FontSize="9" Text="&#xE70D;" Margin="6,1,0,0"
                                           Foreground="{DynamicResource FgSecondary}" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="ВВОД" Style="{StaticResource SectionHeader}" />
                    </DockPanel>
                    <ContentControl Content="{Binding DefaultInput}" ContentTemplate="{StaticResource DeviceCard}" Focusable="False"
                                    Visibility="{Binding DefaultInput, Converter={StaticResource Visibility}}" />
                    <TextBlock Text="Нет подключённых микрофонов" Style="{StaticResource Secondary}" Margin="4,6"
                               Visibility="{Binding DefaultInput, Converter={StaticResource Visibility}, ConverterParameter=Invert}" />
                    <Border Background="{DynamicResource Card}" CornerRadius="6" Padding="4" Margin="0,6,0,0"
                            Visibility="{Binding ShowAllInputs, Converter={StaticResource Visibility}}">
                        <ItemsControl ItemsSource="{Binding Inputs}" ItemTemplate="{StaticResource DeviceRow}" Focusable="False" />
                    </Border>

                    <!-- Программы -->
                    <TextBlock Text="ПРОГРАММЫ" Style="{StaticResource SectionHeader}" Margin="4,16,0,2" />
                    <ScrollViewer x:Name="AppsScroll" VerticalScrollBarVisibility="Auto" MaxHeight="340" Focusable="False">
                        <ItemsControl ItemsSource="{Binding Apps}" ItemTemplate="{StaticResource AppRow}" Focusable="False" />
                    </ScrollViewer>
                    <TextBlock Text="Сейчас ни одна программа не выводит звук" Style="{StaticResource Secondary}" Margin="4,6"
                               Visibility="{Binding HasApps, Converter={StaticResource Visibility}, ConverterParameter=Invert}" />
                </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
