<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- DPI задаём манифестом: это WPF, совет WinForms-анализатора к нам не относится -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <ApplicationIcon>AudioHub.ico</ApplicationIcon>

    <Version>1.0.0</Version>
    <Product>AudioHub</Product>
    <Description>Управление звуком Windows из трея</Description>
    <Copyright>Copyright © 2026 Quroroyr</Copyright>

    <!-- Публикация одним файлом: dotnet publish -c Release -r win-x64 (см. README) -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- WinForms нужен только ради NotifyIcon; не тащим его неймспейсы глобально -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

</Project>
